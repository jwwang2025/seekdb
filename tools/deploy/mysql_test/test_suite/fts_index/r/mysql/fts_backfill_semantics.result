drop database if exists fts_backfill;
create database fts_backfill;
use fts_backfill;
create table docs(id int primary key, body text, cn text) default charset=utf8mb4;
insert into docs values
(1,'Database database DATABASE','数据库 性能 优化'),
(2,'performance audit database','全文索引 数据库 性能'),
(3,'café cafe CAFÉ café','中文 测试 测试'),
(4,'resume résumé naïve','倒排索引 tokenizer'),
(5,'',''),(6,NULL,NULL),(7,'the and a','的 和'),
(8,'audit storage engine','数据库 存储 引擎'),
(9,'database performance audit','数据库 全文索引'),
(10,'DATABASE audit','性能 优化 测试');
create fulltext index beng_ft on docs(body) with parser beng;
create fulltext index ik_ft on docs(cn) with parser ik;
select count(*), sum(id) from docs where match(body) against('database performance audit');
count(*)	sum(id)
5	30
select id, round(match(body) against('database performance audit'), 8) score from docs where match(body) against('database performance audit') order by id;
id	score
1	0.67982732
2	2.74541082
8	0.51528313
9	2.74541082
10	1.09323583
select id, round(match(body) against('cafe café'), 8) score from docs where match(body) against('cafe café') order by id;
id	score
3	3.48568130
select count(*), sum(id) from docs where match(cn) against('数据库 性能');
count(*)	sum(id)
5	30
select id, round(match(cn) against('数据库 全文索引'), 8) score from docs where match(cn) against('数据库 全文索引') order by id;
id	score
1	0.51528313
2	2.23012769
8	0.51528313
9	2.36574356
insert into docs values(11,'database audit café','数据库 性能');
update docs set body='storage database',cn='存储 引擎' where id=3;
delete from docs where id=9;
select count(*), sum(id) from docs where match(body) against('database audit');
count(*)	sum(id)
6	35
select id, round(match(cn) against('数据库 性能'), 8) score from docs where match(cn) against('数据库 性能') order by id;
id	score
1	1.03056626
2	1.03056626
8	0.51528313
10	0.51528313
11	1.09323583
create table binary_docs(id varbinary(16) primary key, body text collate utf8mb4_bin);
insert into binary_docs values(x'00','database audit'),(x'0001','Database Audit'),(x'ff','café cafe'),(x'7fff','storage database');
create fulltext index ft on binary_docs(body) with parser beng;
select hex(id), round(match(body) against('database audit'), 8) score from binary_docs where match(body) against('database audit') order by id;
hex(id)	score
00	0.74324324
0001	0.74324324
7FFF	0.37162162
drop database fts_backfill;
